{
  "name": "sagapyaw",
  "version": "0.1.0",
  "description": "SagaPyaw — Burmese text-to-speech that runs entirely in the browser. Text frontend (G2P) and ONNX inference for YeeNyunn/nara-mini-v1, in TypeScript",
  "type": "module",
  "main": "./dist/sagapyaw.mjs",
  "module": "./dist/sagapyaw.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "data": "python3 tools/export_data.py",
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "golden": "node tools/golden.mjs",
    "check": "npm run typecheck && npm run build && npm run golden && npm run test:pronunciation",
    "fuzz": "python3 tools/gen_fuzz.py && python3 tools/ref.py fuzz_corpus.json fuzz_expected.json && node tools/golden.mjs fuzz_corpus.json fuzz_expected.json",
    "fetch-models": "node tools/fetch_models.mjs",
    "serve": "node tools/serve.mjs 8100",
    "synth": "node tools/synthesize.mjs",
    "verify": "python3 tools/verify_audio.py",
    "test:browser": "node tools/test_browser.mjs \"http://localhost:8100/web/index.html?auto=read\"",
    "test:wav": "node tools/test_wav.mjs \"http://localhost:8100/web/index.html?auto=export\"",
    "test:voices": "node tools/test_voices.mjs",
    "test:sw": "node tools/test_sw.mjs",
    "test:pronunciation": "node tools/test_pronunciation_dictionary.mjs",
    "pack": "node tools/pack.mjs",
    "pack:split": "node tools/pack.mjs --with-models --all --split 20",
    "build:site": "node tools/fetch_models.mjs --all && node tools/build.mjs && node tools/pack.mjs --with-models --all --split 20"
  },
  "keywords": [
    "sagapyaw",
    "burmese",
    "myanmar",
    "g2p",
    "tts",
    "nara-mini",
    "kokoro"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.22.0"
  }
}
